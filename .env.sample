# Scaleway IAM Credentials (Console → IAM → API Keys)
# These are read natively by the Scaleway Terraform provider
SCW_ACCESS_KEY=""
SCW_SECRET_KEY=""
SCW_DEFAULT_PROJECT_ID="" # Console → Projects → <your project> → Settings

# PostgreSQL
# Must be 8-128 chars with uppercase, lowercase, digit, and special character
TF_VAR_postgres_db_password=""

# Region (default: fr-par). Available: fr-par (Paris), nl-ams (Amsterdam), pl-waw (Warsaw)
# TF_VAR_region="fr-par"

# Object Storage
TF_VAR_s3_bucket_name="ducklake-changeme"
